# Copie este arquivo para ".env" e preencha.
# O .env fica só no seu computador: nunca mande para o GitHub (já está no .gitignore).

# Endereço do banco Postgres.
# - No seu computador, com o banco no Render: copie a "External Database URL"
#   e acrescente ?sslmode=verify-full no fim (o Render exige conexão segura de fora).
# - No servidor (Web Service do Render) você não usa este arquivo: cadastre
#   DATABASE_URL nas variáveis de ambiente com a "Internal Database URL", sem nada no fim.
DATABASE_URL=postgres://usuario:senha@localhost:5432/coovir

# Porta da API no seu computador (o site no Vite encaminha /api para ela)
PORT=3000

# Cidade atendida: a busca por CEP e por rua só aceita endereços dela
CIDADE=Viamão
UF=RS
