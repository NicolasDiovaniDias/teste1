{
  "name": "coovir-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Back-end do site da COOVIR: busca da coleta por CEP, rua e bairro, notícias e painel.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/servidor.js",
    "start": "node src/servidor.js",
    "db:criar": "node --env-file=.env scripts/rodar-sql.js db/schema.sql db/seed.sql",
    "admin:criar": "node --env-file=.env scripts/criar-admin.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
